# Production / Deployed API Base URL
EXPO_PUBLIC_PROD_API_URL=https://recipe-cookify-backend.onrender.com/api/

# Local Development API Base URL
# Note: For physical mobile devices / Android Emulators, replace localhost with your local network IP (e.g., http://192.168.1.X:5000/api/)
EXPO_PUBLIC_DEV_API_URL=http://localhost:5000/api/

# Active API URL used by the App (Switch between EXPO_PUBLIC_PROD_API_URL and EXPO_PUBLIC_DEV_API_URL as needed)
EXPO_PUBLIC_API_URL=https://recipe-cookify-backend.onrender.com/api/
